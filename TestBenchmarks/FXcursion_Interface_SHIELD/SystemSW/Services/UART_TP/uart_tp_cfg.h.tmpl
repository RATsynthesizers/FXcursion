/**
 * @file      uart_tp_cfg.h
 *
 * @details   UART transport configuration parameters.
 *
 *            TEMPLATE. Copy this file into the project's Config folder as
 *            uart_tp_cfg.h and edit the values below. It is not compiled from
 *            here - the service includes "uart_tp_cfg.h" and the project's
 *            Config folder is what satisfies that.
 *
 *            Everything the transport needs to know about the board is here,
 *            so moving the link to a different UART or changing its speed is a
 *            change to this file and nothing else.
 *
 * @version   1.0.0
 *
 * \date      04.09.2026 - First release
 *
 * @copyright RAT Synthesizers
 */

#ifndef UART_TP_CFG_H
#define UART_TP_CFG_H



/***************************************************************************************************
* Module includes
***************************************************************************************************/

// Get general definitions
#include "general.h"



/***************************************************************************************************
* Definitions of global (public) constants
***************************************************************************************************/

/**
 * Compile the transport in at all.
 *
 * OFF removes every byte of it - the whole implementation is inside this guard
 * - so a project that does not need a UART transport pays nothing for the
 * service being present in SystemSW.
 */
#define UART_TP_IN_USE                  (ON)

/**
 * Which peripheral carries it.
 *
 * One of the UART_TP_* selectors in uart_tp.h. The service resolves this to the
 * CubeMX handle at compile time, so naming an instance the project has not
 * generated is a build error here rather than a missing symbol at link time.
 *
 * The peripheral must be generated by CubeMX with DMA on BOTH directions and
 * its global interrupt enabled. The transport reconfigures the baud rate but
 * does not create the peripheral.
 */
#define UART_TP_INSTANCE                (UART_TP_USART2)

/**
 * Link speed, baud.
 *
 * Set here rather than in the CubeMX-generated init, because it is a property
 * of the LINK that both ends have to agree on - and a generated file is
 * reverted by the next regeneration.
 *
 * Both ends must match. On parts running from an internal oscillator, check the
 * combined tolerance: 8N1 tolerates roughly +-2% between the two ends, and an
 * uncalibrated HSI can be +-1% on its own at temperature.
 */
#define UART_TP_BAUDRATE                (921600UL)

/**
 * Receive ring, bytes. MUST BE A POWER OF TWO.
 *
 * The DMA fills this continuously and the reader drains it, so this is how far
 * behind the reader may fall before bytes are lost. Size it from the longest
 * gap between reads times the byte rate:
 *
 *   921600 baud = 92 160 B/s = 92 bytes per millisecond
 *
 * so 1024 bytes covers an 11 ms stall. Raise it if the reader runs from a slow
 * loop, not to make the link faster - it does not.
 */
#define UART_TP_RX_RING_BYTES           (1024U)

/**
 * Transmit queue, bytes.
 *
 * Sends are copied in here and handed to the DMA a run at a time, so this
 * bounds how much can be queued ahead. A send larger than the free space is
 * refused whole and counted, so this wants to be a few of the largest frames
 * the protocol layer sends rather than exactly one.
 */
#define UART_TP_TX_QUEUE_BYTES          (512U)



/***************************************************************************************************
* Declarations of global (public) data types
***************************************************************************************************/

/// None.



/***************************************************************************************************
* Declarations of global (public) variables
***************************************************************************************************/

/// None.



#endif  // #ifndef UART_TP_CFG_H

/****************************************** end of file *******************************************/
