/**
 * @file      spi_tp_cfg.h
 *
 * @details   SPI transport configuration parameters.
 *
 *            TEMPLATE. Copy this file into the project's Config folder as
 *            spi_tp_cfg.h and edit the values below. It is not compiled from
 *            here - the service includes "spi_tp_cfg.h" and the project's
 *            Config folder is what satisfies that.
 *
 *            The two ends of the link have their own copy, and only the ROLE
 *            and the kernel clock differ between them. SPI_TP_SCK_HZ must be
 *            IDENTICAL on both, because it is the wire.
 *
 * @version   1.0.0
 *
 * \date      04.09.2026 - First release
 *
 * @copyright RAT Synthesizers
 */

#ifndef SPI_TP_CFG_H
#define SPI_TP_CFG_H



/***************************************************************************************************
* Module includes
***************************************************************************************************/

// Get general definitions
#include "general.h"



/***************************************************************************************************
* Definitions of global (public) constants
***************************************************************************************************/

/**
 * Compile the transport in at all.
 *
 * OFF removes every byte of it - the whole implementation is inside this guard.
 */
#define SPI_TP_IN_USE                   (ON)

/**
 * Which peripheral carries it.
 *
 * One of the SPI_TP_* selectors in spi_tp.h. The peripheral must be generated
 * by CubeMX with DMA on the direction this role uses, and - for a SLAVE - with
 * that DMA channel in CIRCULAR mode. A normal-mode channel initialises fine and
 * then stops after one lap, which looks exactly like the master having died.
 */
#define SPI_TP_INSTANCE                 (SPI_TP_SPI1)

/**
 * Which end this firmware is.
 *
 * SPI_TP_ROLE_MASTER drives SCK and sends a frame when the producer says so.
 * SPI_TP_ROLE_SLAVE  receives into a ring armed once and never re-armed.
 *
 * The master must be told to start only AFTER the slave has armed - a
 * positionally framed stream joined mid-frame is rotated for as long as it
 * runs, with nothing in the payload to reveal it.
 */
#define SPI_TP_ROLE                     (SPI_TP_ROLE_MASTER)

/**
 * Bit clock, Hz. MUST MATCH ON BOTH ENDS - it is the wire.
 *
 * Must also be SPI_TP_KERNEL_HZ / 2^n for n in 1..8, because that is all the
 * prescaler can produce. Anything else is a build error naming both numbers
 * rather than a link that quietly runs at half speed.
 */
#define SPI_TP_SCK_HZ                   (96000000UL)

/**
 * What the RCC actually feeds the peripheral, Hz.
 *
 * NOT the AHB or APB clock unless the selector says so - on parts with a
 * per-peripheral kernel selector this is whichever PLL output is routed to it,
 * and getting it wrong makes every derived figure wrong while still building.
 *
 * A SLAVE needs this to be at least twice SPI_TP_SCK_HZ, and wants more: the
 * input is resynchronised into the kernel domain, so at exactly 2x there is no
 * margin for cable delay or the master's clock-to-out. The failure mode is
 * silent corruption of a stream that has no CRC to catch it, so the two ends
 * may - and often should - run different kernel clocks.
 */
#define SPI_TP_KERNEL_HZ                (192000000UL)



/***************************************************************************************************
* Declarations of global (public) data types
***************************************************************************************************/

/// None.



/***************************************************************************************************
* Declarations of global (public) variables
***************************************************************************************************/

/// None.



#endif  // #ifndef SPI_TP_CFG_H

/****************************************** end of file *******************************************/
